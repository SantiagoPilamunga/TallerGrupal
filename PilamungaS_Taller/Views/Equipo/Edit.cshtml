@model PilamungaS_Taller.Models.Equipo

@{
	ViewData["Title"] = "Edit";
}

<h1> Editar Información</h1>

<h4>Equipo</h4>
<hr />
<div class="row">
	<div class="col-md-6">
		<form asp-action="Edit">
			<div asp-validation-summary="ModelOnly" class="text-danger"></div>
			<input type="hidden" asp-for="Id" />
			<div class="form-group">
				<label asp-for="Nombre" class="control-label"></label>
				<input asp-for="Nombre" class="form-control" />
				<span asp-validation-for="Nombre" class="text-danger"></span>
			</div>
			<div class="form-group">
				<label asp-for="PartidosJugados" class="control-label"></label>
				<input asp-for="PartidosJugados" class="form-control" />
				<span asp-validation-for="PartidosJugados" class="text-danger"></span>
			</div>
			<div class="form-group">
				<label asp-for="PartidosGanados" class="control-label"></label>
				<input asp-for="PartidosGanados" class="form-control" />
				<span asp-validation-for="PartidosGanados" class="text-danger"></span>
			</div>
			<div class="form-group">
				<label asp-for="PartidosEmpatados" class="control-label"></label>
				<input asp-for="PartidosEmpatados" class="form-control" />
				<span asp-validation-for="PartidosEmpatados" class="text-danger"></span>
			</div>
			<div class="form-group">
				<label asp-for="PartidosPerdidos" class="control-label"></label>
				<input asp-for="PartidosPerdidos" class="form-control" />
				<span asp-validation-for="PartidosPerdidos" class="text-danger"></span>
			</div>
			<h4></h4>
			<div class="form-group">
				<input type="submit" value="Save" class="btn btn-primary" />
			</div>
		</form>
	</div>
	<div class="col-md-6">
		<div class="card">
			<div class="card-body">
				<h3>@Model.Nombre</h3>
				<h4>Descripcion</h4>
				<p>@Model.Descripcion</p>
			</div>

			<div class="form-group">
				<label class="control-label"></label>
				<img src="@Model.Logo" alt="Logo de @Model.Nombre" class="img-fluid" style="max-height: 100px;" />
			</div>
		</div>
		<div class="card-body">
			<p><strong>Puntos:</strong> @Model.Puntos</p>
		</div>
	</div>
	<p></p>
	<div class="card">
		<div class="card-body">
			<h4>Jugadores del equipo</h4>
			@if (Model.Jugadores != null && Model.Jugadores.Any())
			{
				<table class="table table-striped">
					<thead>
						<tr>
							<th>Nombre</th>
							<th># Camiseta</th>
							<th>Goles</th>
							<th>Asistencias</th>
							<th></th>
						</tr>
					</thead>
					<tbody>
						@foreach (var jugador in Model.Jugadores)
						{
							<tr>
								<td>@jugador.Nombre</td>
								<td>@jugador.NumeroCamiseta</td>
								<td>@jugador.Goles</td>
								<td>@jugador.AsistenciasTotales</td>
							</tr>
						}
					</tbody>
				</table>
			}
			else
			{
				<p><em>Este equipo no tiene ningun jugador de momento</em></p>
			}
		</div>
	</div>

</div>

<div>
	<a asp-action="List">Volver a la lista</a>
</div>
<br />
<br />
@section Scripts {
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}
	}
